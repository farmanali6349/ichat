# ---------------------------------------------------------------------------
# Production environment for the chat-app container (AWS EC2 + RDS Postgres).
# Copy this to .env.prod on the server, fill in real values, and NEVER commit it.
#   cp .env.prod.example .env.prod   # then edit
# ---------------------------------------------------------------------------

# AWS RDS PostgreSQL connection string.
# - Replace host/user/password/db with your RDS values.
# - sslmode=no-verify keeps the connection encrypted but skips CA verification
#   (RDS certs are not in Node's default trust store). For strict verification,
#   download the RDS CA bundle and use sslmode=verify-full&sslrootcert=/path/ca.pem
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@your-rds-endpoint.xxxxxxxxxx.REGION.rds.amazonaws.com:5432/chat_app?sslmode=no-verify

NODE_ENV=production
PORT=3001

# Clerk keys (use your Clerk production instance keys for real prod).
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

IMAGE_KIT_PRIVATE_KEY=private_replace_me

# Public URL the app is served from, used for CORS. No trailing slash.
# Example: http://<EC2_PUBLIC_IP>  or  https://your-domain.com
FRONTEND_URL=http://<EC2_PUBLIC_IP>
